# ============================================================
# 复制本文件为 .env，并修改密码后使用：
#   Windows PowerShell : Copy-Item .env.example .env
#   macOS / Linux      : cp .env.example .env
#
# 注意：.env 含真实口令，已被 .dockerignore / .gitignore 排除，不要提交
# ============================================================

# MySQL root 密码（必填，容器与后端共用同一值）
DB_PASSWORD=change-me-please
