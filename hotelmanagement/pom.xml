<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.7</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.hotel</groupId>
	<artifactId>hotelmanagement</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>hotelmanagement</name>
	<description>酒店客房预订管理系统 - 后端服务</description>

	<properties>
		<java.version>17</java.version>
		<!-- 指定 Lombok 版本：系统 JDK 为 24，1.18.38 及以上才支持 JDK 24 编译 -->
		<lombok.version>1.18.38</lombok.version>
		<!-- MyBatis-Plus 适配 Spring Boot 3.x 的 Starter 版本 -->
		<mybatis-plus.version>3.5.7</mybatis-plus.version>
	</properties>

	<dependencies>
		<!-- Web 依赖（Spring Boot 3.x 使用 spring-boot-starter-web） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- MyBatis-Plus（Spring Boot 3 专用 starter） -->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
			<version>${mybatis-plus.version}</version>
		</dependency>

		<!-- MySQL 驱动 -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Lombok：编译期自动生成 getter/setter 等样板代码 -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<optional>true</optional>
		</dependency>

		<!-- 密码加密：BCrypt 编码器（只引入 crypto 模块，不引入完整 Spring Security） -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!-- 接口文档：springdoc-openapi（Swagger UI + OpenAPI JSON）
			 2.3.x 对应 Spring Boot 3.2.x -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.3.0</version>
		</dependency>

		<!-- 参数校验（@Valid / jakarta.validation） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
			Redis（Lettuce 客户端）：
			1. 登录会话存 Redis（带 TTL + 滑动续期），替代原内存 ConcurrentHashMap，
			   进程重启不再掉登录态，多实例部署也可用；
			2. 配合 Spring Cache 缓存房态图、客人端房间列表、统计看板等展示读路径。
			本机开发可用 Memurai（Windows 原生 Redis 兼容实现）或 WSL 内的 Redis；
			无 Redis 时可整体切到内存实现，见 application.yml 的 hotel.token-store / hotel.cache-type。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- Lettuce 连接池依赖（spring.data.redis.lettuce.pool 需要它） -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-pool2</artifactId>
		</dependency>

		<!-- 测试 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			显式声明 JUnit Platform Launcher。
			surefire 在跑 JUnit 5 时需要它，但不会自动下载，
			缺少时会报 "artifacts could not be resolved: junit-platform-launcher"。
			官方推荐做法就是自己声明这个依赖（这里固定在 1.10.5，与 Spring Boot 管理的
			JUnit 5.10.x 同一补丁线）。
		-->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<version>1.10.5</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Maven 编译器插件：显式声明 Lombok 注解处理器（JDK 24 必需） -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>